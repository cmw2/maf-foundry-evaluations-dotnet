<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>AAIP001;OPENAI001;SCME0001</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ScienceAgent.cs" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.5" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="3.0.0-beta.5" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
  </ItemGroup>
</Project>
